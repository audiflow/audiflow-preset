{
  "displayName": "A Dynasty to Die For",
  "episodeFilters": {
    "require": [
      {
        "title": "^Season \\d+\\.?\\s*\\||^S\\d+ E\\d+\\s*\\||Dynasty to Die For\\s*$"
      }
    ]
  },
  "episodeItem": {
    "titleExtractor": {
      "fallback": {
        "fallback": {
          "source": "title"
        },
        "pattern": "^Season \\d+\\.?\\s*\\|\\s*(.+)$",
        "source": "title",
        "template": "${1}"
      },
      "pattern": "^S\\d+ E(\\d+)\\s*[|:]\\s*(.+)$",
      "source": "title",
      "template": "${1}. ${2}"
    }
  },
  "episodeListing": {
    "sort": {
      "field": "publishedAt",
      "order": "ascending"
    }
  },
  "groupItem": {
    "showDateRange": true
  },
  "groupListing": {
    "sort": {
      "field": "playlistNumber",
      "order": "ascending"
    },
    "userSortable": true
  },
  "grouping": {
    "by": "titleClassifier",
    "staticClassifiers": [
